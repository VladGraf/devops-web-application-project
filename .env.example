# Optional configuration. Copy this file to .env; no source changes are needed.
# Values must be plain numbers. Ports must be different and between 1024 and 65535.
WEB_PORT=8088
KIBANA_PORT=5601
NODE_PORT=18080
ES_PORT=19200
API_PORT=16443
# Memory is in MiB. Server/worker values are preflight budgets, not node limits.
SERVER_MEMORY_MB=2048
WORKER_MEMORY_MB=1536
NGINX_MEMORY_MB=128
ES_MEMORY_MB=2048
ES_HEAP_MB=768
LOGSTASH_MEMORY_MB=1024
LOGSTASH_HEAP_MB=384
KIBANA_MEMORY_MB=1400
KIBANA_HEAP_MB=768
NGINX_CPUS=0.5
ES_CPUS=2
LOGSTASH_CPUS=1
KIBANA_CPUS=1
APP_CPU_REQUEST_MILLICORES=30
APP_CPU_LIMIT_MILLICORES=300
APP_MEMORY_REQUEST_MB=48
APP_MEMORY_LIMIT_MB=128
FLUENT_CPU_REQUEST_MILLICORES=20
FLUENT_CPU_LIMIT_MILLICORES=200
FLUENT_MEMORY_REQUEST_MB=32
FLUENT_MEMORY_LIMIT_MB=100
